{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netgrid.local/schemas/ai-decision-checkpoint-v1.schema.json",
  "title": "NETGRID AI Decision Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "source",
    "compatibility",
    "actor",
    "difficulty",
    "profileId",
    "deckSnapshot",
    "engine",
    "runtime",
    "expectation"
  ],
  "properties": {
    "schemaVersion": { "const": "ai-decision-checkpoint-v1" },
    "checkpointId": { "type": "string", "minLength": 1 },
    "source": { "type": "object" },
    "compatibility": { "type": "object" },
    "actor": { "enum": ["corp", "runner"] },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "profileId": { "type": "string", "minLength": 1 },
    "deckSnapshot": { "type": "object" },
    "engine": { "type": "object" },
    "runtime": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": "ai-runtime-checkpoint-v1" }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptableActions": { "type": "array" },
        "forbiddenActions": { "type": "array" },
        "choice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mustSelectOptionIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "mustNotSelectOptionIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "mustSelectValues": {
              "type": "array",
              "items": { "type": ["string", "number", "boolean"] }
            },
            "mustNotSelectValues": {
              "type": "array",
              "items": { "type": ["string", "number", "boolean"] }
            }
          }
        },
        "discardChoice": { "type": "object" },
        "strategicIntent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acceptablePrimaryStrategyIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "forbiddenPrimaryStrategyIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "acceptableFamilies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "forbiddenTargetKinds": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "selectedScoreBreakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredComponentKeys": {
              "type": "array",
              "items": { "type": "string" }
            },
            "forbiddenComponentKeys": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
