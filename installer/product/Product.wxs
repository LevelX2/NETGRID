<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="NETGRID"
    Manufacturer="LevelX2"
    Version="$(ProductVersion)"
    UpgradeCode="D8271ACB-E70F-4CD5-9832-DEFE6A052B9F"
    Scope="perMachine"
    InstallerVersion="500"
    Language="1033">
    <SummaryInformation Description="NETGRID private alpha" />
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NETGRID">
        <Directory Id="LEGALFOLDER" Name="legal" />
        <Directory Id="RUNTIMEFOLDER" Name="runtime">
          <Directory Id="NODEFOLDER" Name="node" />
        </Directory>
        <Directory Id="TOOLSFOLDER" Name="tools" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NETGRIDPROGRAMMENU" Name="NETGRID" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Files Include="$(ReleaseRoot)\**" Directory="INSTALLFOLDER" />

    <Component Directory="NODEFOLDER">
      <File Id="NetgridNodeRuntime" Source="$(NodeRoot)\node.exe" />
    </Component>
    <Component Directory="TOOLSFOLDER">
      <File Id="NetgridRuntimeConfig" Source="$(RuntimeConfigRoot)\NETGRID.RuntimeConfig.exe" />
    </Component>
    <Component Directory="INSTALLFOLDER">
      <File Id="NetgridLauncher" Source="$(LauncherRoot)\NETGRID.exe" />
    </Component>
    <Component Directory="INSTALLFOLDER">
      <File Id="NetgridFirstRun" Source="$(FirstRunRoot)\NETGRID.FirstRun.exe" />
    </Component>
    <Component Directory="INSTALLFOLDER">
      <File Id="NetgridUpdater" Source="$(UpdaterRoot)\NETGRID.Updater.exe" />
    </Component>
    <Component Directory="NETGRIDPROGRAMMENU">
      <Shortcut Id="NetgridStartMenuShortcut" Name="NETGRID" Target="[#NetgridLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <Shortcut Id="NetgridMaintenanceStartMenuShortcut" Name="NETGRID Maintenance" Target="[#NetgridLauncher]" Arguments="--open-maintenance" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <Shortcut Id="NetgridFirstRunStartMenuShortcut" Name="NETGRID Ersteinrichtung" Target="[#NetgridFirstRun]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <Shortcut Id="NetgridSetupStartMenuShortcut" Name="NETGRID Setup" Target="[NETGRID_DATA_ROOT]\config\updates\NETGRID-Setup.exe" Arguments="--uninstall" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <RemoveFolder Id="RemoveNetgridProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\LevelX2\NETGRID" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\LevelX2\NETGRID" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" />
    </Component>
    <Component Directory="DesktopFolder" Condition="INSTALLDESKTOPSHORTCUT = 1">
      <Shortcut Id="NetgridDesktopShortcut" Name="NETGRID" Target="[#NetgridLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <RegistryValue Root="HKLM" Key="Software\LevelX2\NETGRID" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="NetgridLicense" Source="$(LegalRoot)\NETGRID-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="ThirdPartyNotices" Source="$(LegalRoot)\THIRD-PARTY-NOTICES.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="NodeLicense" Source="$(LegalRoot)\NODE-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="DotnetLicense" Source="$(LegalRoot)\DOTNET-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="DotnetThirdPartyNotices" Source="$(LegalRoot)\DOTNET-THIRD-PARTY-NOTICES.txt" />
    </Component>

    <Property Id="NETGRID_DATA_ROOT" Secure="yes" />
    <Property Id="NETGRID_REGISTERED_DATA_ROOT" Secure="yes">
      <RegistrySearch Id="NetgridRegisteredDataRoot" Root="HKLM" Key="SOFTWARE\LevelX2\NETGRID" Name="RuntimeDataRoot" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="NETGRID_REGISTERED_INSTALL_FOLDER" Secure="yes">
      <RegistrySearch Id="NetgridRegisteredInstallFolder" Root="HKLM" Key="SOFTWARE\LevelX2\NETGRID" Name="InstallDirectory" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[NETGRID_REGISTERED_INSTALL_FOLDER]" Before="CostFinalize" Sequence="both" Condition='INSTALLFOLDER = "" AND NETGRID_REGISTERED_INSTALL_FOLDER &lt;&gt; ""' />
    <SetProperty Id="NETGRID_DATA_ROOT" Action="ResolveNetgridDataRoot" Value="[NETGRID_REGISTERED_DATA_ROOT]" Before="DefaultNetgridDataRoot" Sequence="both" Condition='NETGRID_DATA_ROOT = "" AND NETGRID_REGISTERED_DATA_ROOT &lt;&gt; ""' />
    <SetProperty Id="NETGRID_DATA_ROOT" Action="DefaultNetgridDataRoot" Value="[CommonAppDataFolder]NETGRID" Before="CostFinalize" Sequence="both" Condition='NETGRID_DATA_ROOT = ""' />
    <SetProperty Id="SOURCELIST" Value="[NETGRID_DATA_ROOT]\config\installer\[ProductCode]" After="CostFinalize" Sequence="execute" Condition="NOT Installed" />
    <Property Id="NETGRID_DEPLOYMENT_PROFILE" Value="local" Secure="yes" />
    <Property Id="NETGRID_LAN_ADDRESS" Secure="yes" />
    <Property Id="NETGRID_WEB_PORT" Value="3100" Secure="yes" />
    <Property Id="NETGRID_SERVER_PORT" Value="8787" Secure="yes" />
    <Property Id="NETGRID_RETENTION_DAYS" Value="30" Secure="yes" />
    <Property Id="NETGRID_ACCOUNT_ACCESS_MODE" Value="simple" Secure="yes" />
    <Property Id="NETGRID_UI_LANGUAGE" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="NETGRID_PREVIOUS_DESKTOP_SHORTCUT" Secure="yes">
      <RegistrySearch Id="NetgridDesktopShortcutPreference" Root="HKLM" Key="SOFTWARE\LevelX2\NETGRID" Name="DesktopShortcutPreference" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty
      Id="INSTALLDESKTOPSHORTCUT"
      Value="[NETGRID_PREVIOUS_DESKTOP_SHORTCUT]"
      Before="CostFinalize"
      Sequence="both"
      Condition='NETGRID_PREVIOUS_DESKTOP_SHORTCUT &lt;&gt; ""' />
    <Property Id="NETGRID_SETUP_SOURCE" Secure="yes" />
    <Property Id="NETGRID_SETUP_SHA256" Secure="yes" />
    <Property Id="DELETEUSERDATA" Value="0" Secure="yes" />
    <SetProperty
      Id="InitializeNetgridRuntime"
      Value='initialize --data-root "[NETGRID_DATA_ROOT]" --deployment-profile "[NETGRID_DEPLOYMENT_PROFILE]" --lan-address "[NETGRID_LAN_ADDRESS]" --web-port "[NETGRID_WEB_PORT]" --server-port "[NETGRID_SERVER_PORT]" --retention-days "[NETGRID_RETENTION_DAYS]" --account-access-mode "[NETGRID_ACCOUNT_ACCESS_MODE]" --desktop-shortcut "[INSTALLDESKTOPSHORTCUT]" --ui-language "[NETGRID_UI_LANGUAGE]" --configure-firewall "true"'
      Before="InitializeNetgridRuntime"
      Sequence="execute"
      Condition='NOT REMOVE~="ALL"' />
    <CustomAction
      Id="InitializeNetgridRuntime"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[InitializeNetgridRuntime]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <SetProperty
      Id="CacheNetgridMsi"
      Value='cache-msi --data-root "[NETGRID_DATA_ROOT]" --source "[OriginalDatabase]" --product-code "[ProductCode]"'
      Before="CacheNetgridMsi"
      Sequence="execute"
      Condition='NOT Installed AND NOT REMOVE~="ALL"' />
    <CustomAction
      Id="CacheNetgridMsi"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[CacheNetgridMsi]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <SetProperty
      Id="CacheNetgridSetup"
      Value='cache-setup --data-root "[NETGRID_DATA_ROOT]" --source "[NETGRID_SETUP_SOURCE]" --sha256 "[NETGRID_SETUP_SHA256]"'
      Before="CacheNetgridSetup"
      Sequence="execute"
      Condition='NOT REMOVE~="ALL" AND NETGRID_SETUP_SOURCE &lt;&gt; ""' />
    <CustomAction
      Id="CacheNetgridSetup"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[CacheNetgridSetup]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <SetProperty
      Id="RemoveNetgridFirewall"
      Value="remove-firewall"
      Before="RemoveNetgridFirewall"
      Sequence="execute"
      Condition='REMOVE~="ALL"' />
    <CustomAction
      Id="RemoveNetgridFirewall"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[RemoveNetgridFirewall]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <SetProperty
      Id="DeleteNetgridData"
      Value='delete-data --data-root "[NETGRID_DATA_ROOT]" --confirmation "DELETE_NETGRID_DATA"'
      Before="DeleteNetgridData"
      Sequence="execute"
      Condition='REMOVE~="ALL" AND DELETEUSERDATA = 1' />
    <CustomAction
      Id="DeleteNetgridData"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[DeleteNetgridData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="InitializeNetgridRuntime" After="InstallFiles" Condition='NOT REMOVE~="ALL"' />
      <Custom Action="CacheNetgridMsi" After="InitializeNetgridRuntime" Condition='NOT Installed AND NOT REMOVE~="ALL"' />
      <Custom Action="CacheNetgridSetup" After="CacheNetgridMsi" Condition='NOT REMOVE~="ALL" AND NETGRID_SETUP_SOURCE &lt;&gt; ""' />
      <Custom Action="RemoveNetgridFirewall" Before="SetDeleteNetgridData" Condition='REMOVE~="ALL"' />
      <Custom Action="DeleteNetgridData" Before="RemoveRegistryValues" Condition='REMOVE~="ALL" AND DELETEUSERDATA = 1' />
    </InstallExecuteSequence>

    <Icon Id="NetgridIcon" SourceFile="$(NetgridIcon)" />
    <Property Id="ARPPRODUCTICON" Value="NetgridIcon" />
  </Package>
</Wix>
