<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="NETGRID"
    Manufacturer="LevelX2"
    Version="$(ProductVersion)"
    UpgradeCode="D8271ACB-E70F-4CD5-9832-DEFE6A052B9F"
    Scope="perMachine"
    InstallerVersion="500"
    Language="1033">
    <SummaryInformation Description="NETGRID private alpha" />
    <MajorUpgrade DowngradeErrorMessage="Eine neuere NETGRID-Version ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NETGRID">
        <Directory Id="LEGALFOLDER" Name="legal" />
        <Directory Id="RUNTIMEFOLDER" Name="runtime">
          <Directory Id="NODEFOLDER" Name="node" />
        </Directory>
        <Directory Id="TOOLSFOLDER" Name="tools" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NETGRIDPROGRAMMENU" Name="NETGRID" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Files Include="$(ReleaseRoot)\**" Directory="INSTALLFOLDER" />

    <Component Directory="NODEFOLDER">
      <File Id="NetgridNodeRuntime" Source="$(NodeRoot)\node.exe" />
    </Component>
    <Component Directory="TOOLSFOLDER">
      <File Id="NetgridRuntimeConfig" Source="$(RuntimeConfigRoot)\NETGRID.RuntimeConfig.exe" />
    </Component>
    <Component Directory="INSTALLFOLDER">
      <File Id="NetgridLauncher" Source="$(LauncherRoot)\NETGRID.exe" />
    </Component>
    <Component Directory="INSTALLFOLDER">
      <File Id="NetgridFirstRun" Source="$(FirstRunRoot)\NETGRID.FirstRun.exe" />
    </Component>
    <Component Directory="NETGRIDPROGRAMMENU">
      <Shortcut Id="NetgridStartMenuShortcut" Name="NETGRID" Target="[#NetgridLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <Shortcut Id="NetgridMaintenanceStartMenuShortcut" Name="NETGRID Maintenance" Target="[#NetgridLauncher]" Arguments="--open-maintenance" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <Shortcut Id="NetgridFirstRunStartMenuShortcut" Name="NETGRID Ersteinrichtung" Target="[#NetgridFirstRun]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <RemoveFolder Id="RemoveNetgridProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\LevelX2\NETGRID" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Directory="DesktopFolder" Condition="INSTALLDESKTOPSHORTCUT = 1">
      <Shortcut Id="NetgridDesktopShortcut" Name="NETGRID" Target="[#NetgridLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="NetgridIcon" />
      <RegistryValue Root="HKLM" Key="Software\LevelX2\NETGRID" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="NetgridLicense" Source="$(LegalRoot)\NETGRID-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="ThirdPartyNotices" Source="$(LegalRoot)\THIRD-PARTY-NOTICES.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="NodeLicense" Source="$(LegalRoot)\NODE-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="DotnetLicense" Source="$(LegalRoot)\DOTNET-LICENSE.txt" />
    </Component>
    <Component Directory="LEGALFOLDER">
      <File Id="DotnetThirdPartyNotices" Source="$(LegalRoot)\DOTNET-THIRD-PARTY-NOTICES.txt" />
    </Component>

    <Property Id="NETGRID_DATA_ROOT" Secure="yes" />
    <Property Id="NETGRID_DEPLOYMENT_PROFILE" Value="local" Secure="yes" />
    <Property Id="NETGRID_LAN_ADDRESS" Secure="yes" />
    <Property Id="NETGRID_WEB_PORT" Value="3100" Secure="yes" />
    <Property Id="NETGRID_SERVER_PORT" Value="8787" Secure="yes" />
    <Property Id="NETGRID_RETENTION_DAYS" Value="30" Secure="yes" />
    <Property Id="NETGRID_ACCOUNT_ACCESS_MODE" Value="simple" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <SetProperty
      Id="InitializeNetgridRuntime"
      Value='initialize --data-root "[NETGRID_DATA_ROOT]" --deployment-profile "[NETGRID_DEPLOYMENT_PROFILE]" --lan-address "[NETGRID_LAN_ADDRESS]" --web-port "[NETGRID_WEB_PORT]" --server-port "[NETGRID_SERVER_PORT]" --retention-days "[NETGRID_RETENTION_DAYS]" --account-access-mode "[NETGRID_ACCOUNT_ACCESS_MODE]" --configure-firewall "true"'
      Before="InitializeNetgridRuntime"
      Sequence="execute"
      Condition='NOT REMOVE~="ALL"' />
    <CustomAction
      Id="InitializeNetgridRuntime"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <SetProperty
      Id="RemoveNetgridFirewall"
      Value="remove-firewall"
      Before="RemoveNetgridFirewall"
      Sequence="execute"
      Condition='REMOVE~="ALL"' />
    <CustomAction
      Id="RemoveNetgridFirewall"
      FileRef="NetgridRuntimeConfig"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="InitializeNetgridRuntime" After="InstallFiles" Condition='NOT REMOVE~="ALL"' />
      <Custom Action="RemoveNetgridFirewall" Before="RemoveFiles" Condition='REMOVE~="ALL"' />
    </InstallExecuteSequence>

    <Icon Id="NetgridIcon" SourceFile="$(NetgridIcon)" />
    <Property Id="ARPPRODUCTICON" Value="NetgridIcon" />
  </Package>
</Wix>
