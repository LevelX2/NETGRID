{
  "name": "netgrid-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "e2e": "node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build:ai": "corepack pnpm build:ai-compiled-hints",
    "check:ai": "corepack pnpm check:ai-compiled-hints && corepack pnpm check:ai-derived-facts && corepack pnpm check:ai-hint-compiled-index && corepack pnpm check:ai-manual-overlays && corepack pnpm check:ai-action-semantic-signal-catalog",
    "check:ai:full": "corepack pnpm check:ai && corepack pnpm check:ai-derived-facts-full",
    "build:ai-compiled-hints": "node scripts/build-ai-compiled-hints.mjs --write",
    "build:ai-hint-inspector-index": "node scripts/build-ai-hint-inspector-index.mjs --write",
    "build:proteus-ai-readiness-inventory": "node scripts/build-proteus-ai-readiness-inventory.mjs --write",
    "build:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --write",
    "build:proteus-ai-selected-pilot": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --write",
    "check:ai-compiled-hints": "node scripts/check-ai-compiled-hints.mjs",
    "check:ai-hint-inspector-index": "node scripts/build-ai-hint-inspector-index.mjs --check",
    "check:ai-approval-consistency": "node scripts/check-ai-approval-consistency.mjs",
    "check:ai-derived-facts": "node scripts/check-ai-derived-facts.mjs --check",
    "check:ai-derived-facts-full": "node scripts/check-ai-derived-facts-full.mjs --check",
    "check:ai-hint-compiled-index": "node scripts/check-ai-hint-compiled-index.mjs --check",
    "check:ai-manual-overlays": "node scripts/check-ai-manual-overlays.mjs --check",
    "check:ai-action-semantic-signal-catalog": "node scripts/check-ai-action-semantic-signal-catalog.mjs --check",
    "check:proteus-ai-readiness": "node scripts/check-proteus-ai-readiness.mjs",
    "check:proteus-ai-readiness-inventory": "node scripts/build-proteus-ai-readiness-inventory.mjs --check",
    "check:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --check",
    "check:proteus-ai-selected-pilot": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --check",
    "check:card-function-abstraction": "node scripts/check-card-name-leakage-in-runtime.mjs",
    "check:card-asset-retention": "node scripts/check-card-asset-retention.mjs",
    "check:engine-cardimplementation-architecture-target": "node scripts/check-engine-cardimplementation-architecture-target.mjs",
    "check:engine-cardimplementation-architecture-target:selftest": "node scripts/check-engine-cardimplementation-architecture-target.mjs --self-test",
    "check:package-boundaries": "node scripts/check-package-boundaries.mjs",
    "check:package-boundaries:selftest": "node scripts/check-package-boundaries.mjs --self-test",
    "check:ai-hint-quality": "node scripts/check-ai-hint-quality.mjs --write-report",
    "check:ai-strategy-taxonomy": "node scripts/check-ai-strategy-taxonomy.mjs --write-reports",
    "check:ai-deck-doctrine-strategy": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/check-ai-deck-doctrine-strategy.ts",
    "check:chronicle-choice-fallbacks": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/check-chronicle-choice-fallbacks.ts",
    "storage:backup": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts backup",
    "storage:restore": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts restore",
    "storage:inspect": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts inspect",
    "local-transfer:export": "powershell -ExecutionPolicy Bypass -File scripts/export-local-transfer.ps1",
    "local-transfer:import": "powershell -ExecutionPolicy Bypass -File scripts/import-local-transfer.ps1",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test && vitest run tests/specs/phase1-artifacts.test.ts tests/specs/visibility-contract.test.ts --passWithNoTests",
    "test:contracts": "corepack pnpm --filter @netgrid/shared test && vitest run tests/specs/phase1-artifacts.test.ts tests/specs/visibility-contract.test.ts",
    "test:ai:shards": "corepack pnpm --filter @netgrid/ai test:shard:1 && corepack pnpm --filter @netgrid/ai test:shard:2 && corepack pnpm --filter @netgrid/ai test:shard:3",
    "build": "corepack pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-format-changed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
