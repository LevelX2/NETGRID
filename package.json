{
  "name": "netgrid-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "e2e": "node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:ai-approval-consistency": "node scripts/check-ai-approval-consistency.mjs",
    "check:ai-derived-facts": "node scripts/check-ai-derived-facts.mjs --check",
    "check:ai-generated-fact-batch1-diff-review": "node scripts/check-ai-generated-fact-batch1-diff-review.mjs --check",
    "check:ai-generated-fact-batch1-normalization-dry-run": "node scripts/check-ai-generated-fact-batch1-normalization-dry-run.mjs --check",
    "check:ai-generated-fact-batch1-rollup": "node scripts/check-ai-generated-fact-batch1-rollup.mjs --check",
    "check:ai-generated-fact-batch2-diff-review": "node scripts/check-ai-generated-fact-batch2-diff-review.mjs --check",
    "check:ai-generated-fact-batch2-dry-run": "node scripts/check-ai-generated-fact-batch2-dry-run.mjs --check",
    "check:ai-generated-fact-batch2-normalization-dry-run": "node scripts/check-ai-generated-fact-batch2-normalization-dry-run.mjs --check",
    "check:ai-generated-fact-batch2-rollup": "node scripts/check-ai-generated-fact-batch2-rollup.mjs --check",
    "check:ai-generated-fact-batch3-diff-review": "node scripts/check-ai-generated-fact-batch3-diff-review.mjs --check",
    "check:ai-generated-fact-batch3-dry-run": "node scripts/check-ai-generated-fact-batch3-dry-run.mjs --check",
    "check:ai-generated-fact-migration-dry-run": "node scripts/check-ai-generated-fact-migration-dry-run.mjs --check",
    "check:ai-generated-fact-migration-priority": "node scripts/check-ai-generated-fact-migration-priority.mjs --check",
    "check:ai-hint-compiled-index": "node scripts/check-ai-hint-compiled-index.mjs --check",
    "check:ai-manual-overlays": "node scripts/check-ai-manual-overlays.mjs --check",
    "check:ai-hint-quality": "node scripts/check-ai-hint-quality.mjs --write-report",
    "storage:backup": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts backup",
    "storage:restore": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts restore",
    "storage:inspect": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts inspect",
    "storage:import-legacy": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts import-legacy",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test && vitest run tests/specs/phase1-artifacts.test.ts tests/specs/visibility-contract.test.ts --passWithNoTests",
    "build": "corepack pnpm -r --if-present build",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
