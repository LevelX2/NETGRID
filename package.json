{
  "name": "netgrid-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "e2e": "node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:ai": "pnpm check:ai-hint-metadata-contracts && pnpm check:ai-source-structure && pnpm check:ai-generic-card-id-guards",
    "build:proteus-ai-readiness-inventory": "pnpm exec tsx scripts/build-proteus-ai-readiness-inventory.mjs --write",
    "build:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --write",
    "build:proteus-ai-selected-pilot": "pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --write",
    "audit:ai-economy": "pnpm exec tsx scripts/audit-ai-economy-contracts.mjs",
    "audit:ai-action-capacity": "pnpm exec tsx scripts/audit-ai-action-capacity-contracts.mjs",
    "check:ai-action-capacity": "pnpm exec tsx scripts/audit-ai-action-capacity-contracts.mjs --check",
    "check:ai-economy": "pnpm exec tsx scripts/audit-ai-economy-contracts.mjs --check",
    "check:ai-approval-consistency": "pnpm exec tsx scripts/check-ai-approval-consistency.mjs",
    "check:ai-hint-metadata-contracts": "pnpm exec tsx scripts/check-ai-hint-metadata-contracts.mjs",
    "check:ai-source-structure": "node scripts/check-ai-source-structure.mjs && node scripts/audit-ai-source-reachability.mjs --check",
    "check:ai-source-structure:selftest": "node scripts/check-ai-source-structure.mjs --self-test",
    "check:ai-generic-card-id-guards": "node scripts/check-ai-generic-card-id-guards.mjs",
    "check:ai-generic-card-id-guards:selftest": "node scripts/check-ai-generic-card-id-guards.mjs --self-test",
    "check:proteus-ai-readiness": "pnpm exec tsx scripts/check-proteus-ai-readiness.mjs",
    "check:proteus-ai-readiness-inventory": "pnpm exec tsx scripts/build-proteus-ai-readiness-inventory.mjs --check",
    "check:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --check",
    "check:proteus-ai-selected-pilot": "pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --check",
    "check:card-function-abstraction": "node scripts/check-card-name-leakage-in-runtime.mjs",
    "check:card-function-abstraction:selftest": "node scripts/check-card-name-leakage-in-runtime.mjs --self-test-location-drift && node scripts/check-card-name-leakage-in-runtime.mjs --self-test-new-leak",
    "check:card-asset-retention": "node scripts/check-card-asset-retention.mjs",
    "card-images:template": "pnpm --filter @netgrid/card-images cli template",
    "card-images:import": "pnpm --filter @netgrid/card-images cli import",
    "card-images:import-https": "pnpm --filter @netgrid/card-images cli import-https",
    "card-images:pack-template": "pnpm --filter @netgrid/card-images cli pack-template",
    "card-images:pack-build": "pnpm --filter @netgrid/card-images cli pack-build",
    "card-images:pack-import": "pnpm --filter @netgrid/card-images cli pack-import",
    "check:engine-cardimplementation-architecture-target": "node scripts/check-engine-cardimplementation-architecture-target.mjs",
    "check:engine-cardimplementation-architecture-target:selftest": "node scripts/check-engine-cardimplementation-architecture-target.mjs --self-test",
    "check:engine-source-structure": "node scripts/check-engine-source-structure.mjs",
    "check:engine-source-structure:selftest": "node scripts/check-engine-source-structure.mjs --self-test",
    "check:cards-source-structure": "node scripts/check-cards-source-structure.mjs",
    "check:cards-source-structure:selftest": "node scripts/check-cards-source-structure.mjs --self-test",
    "generate:card-spec-import-index": "node scripts/generate-card-spec-import-index.mjs --write",
    "generate:card-spec-ai-hints": "pnpm exec tsx scripts/generate-card-spec-ai-hints.mts --write",
    "check:card-spec-ai-hints": "pnpm exec tsx scripts/generate-card-spec-ai-hints.mts --check",
    "check:card-spec-import-index": "node scripts/generate-card-spec-import-index.mjs --check",
    "check:card-spec-import-index:selftest": "node scripts/generate-card-spec-import-index.mjs --self-test",
    "check:card-registry-match-retention": "tsx scripts/check-card-registry-match-retention.mts",
    "check:card-spec-decision-checkpoints": "tsx scripts/rebase-card-spec-decision-checkpoints.mts --check",
    "check:engine-credit-gain-boundary": "node scripts/check-engine-credit-gain-boundary.mjs",
    "check:package-boundaries": "node scripts/check-package-boundaries.mjs",
    "check:package-boundaries:selftest": "node scripts/check-package-boundaries.mjs --self-test",
    "check:test-discovery": "node scripts/check-vitest-discovery.mjs",
    "check:icebreaker-run-semantics": "pnpm exec tsx scripts/check-icebreaker-run-semantics.mjs && pnpm --filter @netgrid/engine exec vitest run src/game/view/icebreaker-run-semantics-audit.test.ts",
    "check:localized-agenda-skin-source": "pnpm exec tsx scripts/generate-localized-agenda-skin-data.mjs --check-source",
    "check:i18n": "node scripts/check-web-i18n.mjs",
    "check:ai-deck-doctrine-strategy": "pnpm --filter @netgrid/server exec tsx ../../scripts/check-ai-deck-doctrine-strategy.ts",
    "check:standard-deck-guides": "pnpm --filter @netgrid/server exec tsx ../../scripts/check-standard-deck-guides.ts",
    "analyze:standard-deck-guides": "pnpm --filter @netgrid/server exec tsx ../../scripts/analyze-standard-deck-guides.ts",
    "benchmark:ai-behavior": "pnpm --filter @netgrid/server exec tsx ../../scripts/run-ai-behavior-baseline.ts",
    "ai:checkpoint:export": "tsx scripts/export-ai-decision-replay-fixture.ts",
    "selfplay:evidence": "node scripts/ai-selfplay-evidence-registry.mjs",
    "test:selfplay-evidence": "node --test scripts/ai-selfplay-evidence-registry.test.mjs",
    "storage:backup": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts backup",
    "storage:restore": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts restore",
    "storage:inspect": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts inspect",
    "storage:optimize": "pnpm --filter @netgrid/server exec tsx src/storage-cli.ts optimize",
    "maintenance:auth": "pnpm --filter @netgrid/server exec tsx src/maintenance-auth-cli.ts",
    "account:auth": "pnpm --filter @netgrid/server exec tsx src/account-auth-cli.ts",
    "local-transfer:export": "powershell -ExecutionPolicy Bypass -File scripts/export-local-transfer.ps1",
    "local-transfer:import": "powershell -ExecutionPolicy Bypass -File scripts/import-local-transfer.ps1",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm check:test-discovery && vitest run tests/specs --passWithNoTests",
    "test:contracts": "pnpm --filter @netgrid/shared test && pnpm check:test-discovery && vitest run tests/specs",
    "test:ai:plans": "pnpm --filter @netgrid/ai test:plans",
    "test:ai:runtime": "pnpm --filter @netgrid/ai test:runtime",
    "test:ai:checkpoints": "pnpm --filter @netgrid/ai test:checkpoints",
    "test:ai:simulation": "pnpm --filter @netgrid/ai test:simulation",
    "test:ai:shards": "node scripts/run-ai-test-shards.mjs",
    "test:ai:shards:serial": "pnpm --filter @netgrid/ai test:shard:1 && pnpm --filter @netgrid/ai test:shard:2 && pnpm --filter @netgrid/ai test:shard:3",
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-format-changed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "esbuild": "0.27.7",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
