{
  "name": "netgrid-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "e2e": "node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:ai": "corepack pnpm check:ai-hint-metadata-contracts && corepack pnpm check:ai-source-structure && corepack pnpm check:ai-generic-card-id-guards",
    "build:proteus-ai-readiness-inventory": "node scripts/build-proteus-ai-readiness-inventory.mjs --write",
    "build:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --write",
    "build:proteus-ai-selected-pilot": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --write",
    "audit:ai-economy": "node scripts/audit-ai-economy-contracts.mjs",
    "audit:ai-action-capacity": "node scripts/audit-ai-action-capacity-contracts.mjs",
    "normalize:ai-action-capacity-hints": "node scripts/normalize-ai-action-capacity-hints.mjs",
    "check:ai-action-capacity-hints": "node scripts/normalize-ai-action-capacity-hints.mjs --check",
    "check:ai-action-capacity": "pnpm check:ai-action-capacity-hints && node scripts/audit-ai-action-capacity-contracts.mjs --check",
    "check:ai-economy": "node scripts/audit-ai-economy-contracts.mjs --check",
    "check:ai-approval-consistency": "node scripts/check-ai-approval-consistency.mjs",
    "check:ai-hint-metadata-contracts": "node scripts/check-ai-hint-metadata-contracts.mjs",
    "check:ai-source-structure": "node scripts/check-ai-source-structure.mjs",
    "check:ai-source-structure:selftest": "node scripts/check-ai-source-structure.mjs --self-test",
    "check:ai-generic-card-id-guards": "node scripts/check-ai-generic-card-id-guards.mjs",
    "check:ai-generic-card-id-guards:selftest": "node scripts/check-ai-generic-card-id-guards.mjs --self-test",
    "check:proteus-ai-readiness": "node scripts/check-proteus-ai-readiness.mjs",
    "check:proteus-ai-readiness-inventory": "node scripts/build-proteus-ai-readiness-inventory.mjs --check",
    "check:proteus-ai-family-scenarios": "node scripts/build-proteus-ai-family-scenarios.mjs --check",
    "check:proteus-ai-selected-pilot": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/run-proteus-ai-selected-pilot.ts --check",
    "check:card-function-abstraction": "node scripts/check-card-name-leakage-in-runtime.mjs",
    "check:card-asset-retention": "node scripts/check-card-asset-retention.mjs",
    "check:engine-cardimplementation-architecture-target": "node scripts/check-engine-cardimplementation-architecture-target.mjs",
    "check:engine-cardimplementation-architecture-target:selftest": "node scripts/check-engine-cardimplementation-architecture-target.mjs --self-test",
    "check:engine-source-structure": "node scripts/check-engine-source-structure.mjs",
    "check:engine-source-structure:selftest": "node scripts/check-engine-source-structure.mjs --self-test",
    "check:engine-credit-gain-boundary": "node scripts/check-engine-credit-gain-boundary.mjs",
    "check:package-boundaries": "node scripts/check-package-boundaries.mjs",
    "check:package-boundaries:selftest": "node scripts/check-package-boundaries.mjs --self-test",
    "check:test-discovery": "node scripts/check-vitest-discovery.mjs",
    "check:ai-hint-quality": "node scripts/check-ai-hint-quality.mjs --write-report",
    "check:icebreaker-run-semantics": "node scripts/check-icebreaker-run-semantics.mjs",
    "check:ai-deck-doctrine-strategy": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/check-ai-deck-doctrine-strategy.ts",
    "check:standard-deck-guides": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/check-standard-deck-guides.ts",
    "analyze:standard-deck-guides": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/analyze-standard-deck-guides.ts",
    "benchmark:ai-behavior": "corepack pnpm --filter @netgrid/server exec tsx ../../scripts/run-ai-behavior-baseline.ts",
    "storage:backup": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts backup",
    "storage:restore": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts restore",
    "storage:inspect": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts inspect",
    "storage:optimize": "corepack pnpm --filter @netgrid/server exec tsx src/storage-cli.ts optimize",
    "maintenance:auth": "corepack pnpm --filter @netgrid/server exec tsx src/maintenance-auth-cli.ts",
    "account:auth": "corepack pnpm --filter @netgrid/server exec tsx src/account-auth-cli.ts",
    "local-transfer:export": "powershell -ExecutionPolicy Bypass -File scripts/export-local-transfer.ps1",
    "local-transfer:import": "powershell -ExecutionPolicy Bypass -File scripts/import-local-transfer.ps1",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test && corepack pnpm check:test-discovery && vitest run tests/specs --passWithNoTests",
    "test:contracts": "corepack pnpm --filter @netgrid/shared test && corepack pnpm check:test-discovery && vitest run tests/specs",
    "test:ai:plans": "corepack pnpm --filter @netgrid/ai test:plans",
    "test:ai:runtime": "corepack pnpm --filter @netgrid/ai test:runtime",
    "test:ai:checkpoints": "corepack pnpm --filter @netgrid/ai test:checkpoints",
    "test:ai:simulation": "corepack pnpm --filter @netgrid/ai test:simulation",
    "test:ai:shards": "node scripts/run-ai-test-shards.mjs",
    "test:ai:shards:serial": "corepack pnpm --filter @netgrid/ai test:shard:1 && corepack pnpm --filter @netgrid/ai test:shard:2 && corepack pnpm --filter @netgrid/ai test:shard:3",
    "build": "corepack pnpm -r --if-present build",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-format-changed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
