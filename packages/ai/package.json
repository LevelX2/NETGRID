{
  "name": "@netgrid/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog-ai-hint-public.ts",
    "./product-simulation": "./src/product-simulation.ts",
    "./simulation": "./src/simulation.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --testTimeout=30000",
    "test:plans": "vitest run --maxWorkers=1 --testTimeout=30000 src/plans",
    "test:runtime": "vitest run --maxWorkers=1 --testTimeout=30000 src/runtime",
    "test:checkpoints": "vitest run --maxWorkers=1 --testTimeout=30000 src/evaluation/decision-checkpoints",
    "test:simulation": "vitest run --maxWorkers=1 --testTimeout=30000 src/simulation",
    "test:shard:1": "vitest run --maxWorkers=1 --testTimeout=30000 --shard=1/3",
    "test:shard:2": "vitest run --maxWorkers=1 --testTimeout=30000 --shard=2/3",
    "test:shard:3": "vitest run --maxWorkers=1 --testTimeout=30000 --shard=3/3",
    "build": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@netgrid/catalog": "workspace:*",
    "@netgrid/cards": "workspace:*",
    "@netgrid/decks": "workspace:*",
    "@netgrid/engine": "workspace:*",
    "@netgrid/runtime-data": "workspace:*",
    "@netgrid/shared": "workspace:*"
  }
}
