<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NETGRID.Setup</AssemblyName>
    <RootNamespace>Netgrid.SetupHost</RootNamespace>
    <ApplicationIcon>..\..\web\public\brand\netgrid.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\WindowsUiStrings.cs" Link="WindowsUiStrings.cs" />
    <EmbeddedResource Include="..\Common\windows-ui-strings.json" LogicalName="NETGRID.WindowsUiStrings.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(EmbeddedMsiPath)' != ''">
    <EmbeddedResource Include="$(EmbeddedMsiPath)" LogicalName="NETGRID.Product.msi" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetgridPayloadBytes</_Parameter1>
      <_Parameter2>$(NetgridPayloadBytes)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetgridPayloadFileCount</_Parameter1>
      <_Parameter2>$(NetgridPayloadFileCount)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetgridMsiBytes</_Parameter1>
      <_Parameter2>$(NetgridMsiBytes)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetgridMsiSha256</_Parameter1>
      <_Parameter2>$(EmbeddedMsiSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetgridProductVersion</_Parameter1>
      <_Parameter2>$(NetgridProductVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
