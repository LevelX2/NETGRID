<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NETGRID.FirstRun</AssemblyName>
    <RootNamespace>Netgrid.FirstRun</RootNamespace>
    <ApplicationIcon>..\..\web\public\brand\netgrid.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\WindowsUiStrings.cs" Link="WindowsUiStrings.cs" />
    <Compile Include="..\Common\WindowsUiLanguage.cs" Link="WindowsUiLanguage.cs" />
    <Compile Include="..\Common\InstallationGate.cs" Link="InstallationGate.cs" />
    <Compile Include="..\Common\InstallationLaunchFence.cs" Link="InstallationLaunchFence.cs" />
    <EmbeddedResource Include="..\Common\windows-ui-strings.json" LogicalName="NETGRID.WindowsUiStrings.json" />
  </ItemGroup>
</Project>
