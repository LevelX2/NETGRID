<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NETGRID.InstallerActions</AssemblyName>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="[7.0.0]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]" PrivateAssets="all" />
    <Compile Include="..\Common\InstallationGate.cs" Link="InstallationGate.cs" />
    <Compile Include="..\Common\InstallationLaunchFence.cs" Link="InstallationLaunchFence.cs" />
    <Compile Include="..\Common\InstallationLease.cs" Link="InstallationLease.cs" />
    <Compile Include="..\Common\InstallationLease.MsiData.cs" Link="InstallationLease.MsiData.cs" />
    <Compile Include="..\Common\MsiDataBinding.cs" Link="MsiDataBinding.cs" />
    <Compile Include="..\Common\UpdateRecoveryBinding.cs" Link="UpdateRecoveryBinding.cs" />
    <Compile Include="..\Common\ProductProcesses.cs" Link="ProductProcesses.cs" />
    <Compile Include="..\Common\UpdateHandoff.cs" Link="UpdateHandoff.cs" />
    <Compile Include="..\Common\DirectMsiPreparation.cs" Link="DirectMsiPreparation.cs" />
    <Compile Include="..\Common\MsiOfflineReadiness.cs" Link="MsiOfflineReadiness.cs" />
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
